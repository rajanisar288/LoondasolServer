# ==============================================================================
# WorkivLab — Production Server Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=https://app.workivlab.com,http://localhost:4200

# Cryptographic Authentication Secrets (MUST BE STRONG & RANDOM IN PRODUCTION)
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Master Database (Global Identities, Companies, Tenant Routing)
MONGODB_MASTER_URI=mongodb://localhost:27017/workivlab_master

# Regional Datacenter Shards (Data Sovereignty Compliance)
# If a specific regional URI is omitted, the system falls back to MONGODB_MASTER_URI with /workivlab_<region>
MONGODB_PK_URI=mongodb://localhost:27017/workivlab_pk
MONGODB_IND_URI=mongodb://localhost:27017/workivlab_ind
MONGODB_USA_URI=mongodb://localhost:27017/workivlab_usa
MONGODB_EU_URI=mongodb://localhost:27017/workivlab_eu
MONGODB_UAE_URI=mongodb://localhost:27017/workivlab_uae

# Redis Cache & Real-Time Socket.IO Cluster Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Public Application URL
APP_URL=http://localhost:4200

# Gmail SMTP Email Delivery Service
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM=your_smtp_email@gmail.com

# Cloudinary CDN Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

